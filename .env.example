# Public SDK keys from RevenueCat Dashboard -> Project Settings -> API Keys
EXPO_PUBLIC_RC_IOS_KEY=appl_replace_with_your_ios_public_key
EXPO_PUBLIC_RC_ANDROID_KEY=goog_replace_with_your_android_public_key

# Actual deployed legal documents.
# Purchases remain disabled until these are configured.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=


# Enable only after real store offers and legal
# documents have been configured and tested.
EXPO_PUBLIC_ANDROID_OFFERS_ENABLED=false
EXPO_PUBLIC_IOS_OFFERS_ENABLED=false

EXPO_PUBLIC_CIRCLES_API_URL=

EXPO_PUBLIC_STILLWATER_SHARE_URL=
